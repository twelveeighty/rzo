[
    {
        "apiVersion": "v1",
        "kind": "Policy",
        "metadata": {
            "name": "drivers"
        },
        "spec": {
            "type": "server.policy.Policy",
            "appliesTo": "drivers",
            "statements": [
                { "resource": "entity/login", "action": "delete",
                  "effect": "allow",
                  "where": {
                      "match": "all", "conditions": [
                          { "attr": "useraccountnum_id",
                            "op": "eq",
                            "subject": "${userid}"
                          }
                      ]
                  }
                },
                { "resource": "entity/zone", "action": "get",
                  "effect": "allow"
                },
                { "resource": "entity/rider", "action": "get",
                  "effect": "allow"
                },
                { "resource": "entity/driver", "action": "get",
                  "effect": "allow",
                  "where": {
                      "match": "all", "conditions": [
                          { "attr": "_id",
                            "op": "eq",
                            "subject": "${my.driver}"
                          }
                      ]
                  }
                },
                { "resource": "entity/trip", "action": "get",
                  "effect": "allow",
                  "where": {
                      "match": "any", "conditions": [
                          { "attr": "drivernum_id",
                            "op": "isNull"
                          },
                          { "attr": "drivernum_id",
                            "op": "eq",
                            "subject": "${my.driver}"
                          }
                      ]
                  }
                },
                { "resource": "entity/trip", "action": "put",
                  "effect": "allow",
                  "where": {
                      "match": "any", "conditions": [
                          { "attr": "drivernum_id",
                            "op": "eq",
                            "subject": "${my.driver}"
                          },
                          { "attr": "drivernum_id",
                            "op": "isNull"
                          }
                      ]
                  }
                }
            ]
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Policy",
        "metadata": {
            "name": "riders"
        },
        "spec": {
            "type": "server.policy.Policy",
            "appliesTo": "riders",
            "statements": [
                { "resource": "entity/login", "action": "delete",
                  "effect": "allow",
                  "where": {
                      "match": "all", "conditions": [
                          { "attr": "useraccountnum_id",
                            "op": "eq",
                            "subject": "${userid}"
                          }
                      ]
                  }
                },
                { "resource": "entity/zone", "action": "get",
                  "effect": "allow"
                },
                { "resource": "entity/rider", "action": "get",
                  "effect": "allow",
                  "where": {
                      "match": "all", "conditions": [
                          { "attr": "_id",
                            "op": "eq",
                            "subject": "${my.rider}"
                          }
                      ]
                  }
                },
                { "resource": "entity/driver", "action": "get",
                  "effect": "deny"
                },
                { "resource": "entity/trip", "action": "get",
                  "effect": "allow",
                  "where": {
                      "match": "all", "conditions": [
                          { "attr": "ridernum_id",
                            "op": "eq",
                            "subject": "${my.rider}"
                          }
                      ]
                  }
                },
                { "resource": "entity/trip", "action": "put",
                  "effect": "allow",
                  "where": {
                      "match": "any", "conditions": [
                          { "attr": "ridernum_id",
                            "op": "eq",
                            "subject": "${my.rider}"
                          },
                          { "attr": "ridernum_id",
                            "op": "isNull"
                          }
                      ]
                  }
                }
            ]
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Policy",
        "metadata": {
            "name": "onetimelogins"
        },
        "spec": {
            "type": "server.policy.Policy",
            "appliesTo": "onetimelogins",
            "statements": [
                { "resource": "entity/onetimelogin", "action": "get",
                  "effect": "allow",
                  "where": {
                      "match": "all", "conditions": [
                          { "attr": "useraccountnum_id",
                            "op": "eq",
                            "subject": "${userid}"
                          },
                          { "attr": "useraccountnum_id",
                            "op": "ne",
                            "subject": "00000000-0000-1000-8000-000000000000"
                          }
                      ]
                  }
                },
                { "resource": "entity/login", "action": "delete",
                  "effect": "allow",
                  "where": {
                      "match": "all", "conditions": [
                          { "attr": "useraccountnum_id",
                            "op": "eq",
                            "subject": "${userid}"
                          }
                      ]
                  }
                },
                { "resource": "entity/login", "action": "post",
                  "effect": "allow",
                  "where": {
                      "match": "all", "conditions": [
                          { "attr": "useraccountnum_id",
                            "op": "eq",
                            "subject": "${userid}"
                          }
                      ]
                  }
                }
            ]
        }
    },
    {
