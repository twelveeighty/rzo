[
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "pgconnection"
        },
        "spec": {
            "type": "server.pg-client.PgConnection",
            "connectionTimeoutMillis": 0,
            "idleTimeoutMillis": 10000,
            "max": 10,
            "allowExitOnIdle": false,
            "pageSize": 100
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Source",
        "metadata": {
            "name": "db"
        },
        "spec": {
            "type": "server.pg-client.PgClientSource",
            "pool": "pgconnection"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "leaderelector"
        },
        "spec": {
            "type": "server.election.LeaderElector",
            "source": "db",
            "leaderElectRowId": 1,
            "leaderCastVoteInterval": "1 minute",
            "leaderCastVoteFrequency": 60000,
            "leaderReelectFrequency": 30000
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "balancelog"
        },
        "spec": {
            "type": "server.pg-balancelog.BalanceLogWorker",
            "pool": "pgconnection",
            "leaderElector": "leaderelector",
            "extraMinutes": 1,
            "checkFrequency": 30000
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "hoover",
            "voided": true
        },
        "spec": {
            "type": "server.hoover.HooverWorker",
            "source": "db",
            "leaderElector": "leaderelector",
            "checkFrequency": 86400000
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Source",
        "metadata": {
            "name": "replicationdb"
        },
        "spec": {
            "type": "server.pg-replication.PgReplicationSource",
            "pool": "pgconnection"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Source",
        "metadata": {
            "name": "imreplicationdb"
        },
        "spec": {
            "type": "server.pg-imreplication.PgImReplicationSource",
            "pool": "pgconnection"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Source",
        "metadata": {
            "name": "pgattachdb"
        },
        "spec": {
            "type": "server.pg-attach.PgAttachSource",
            "pool": "pgconnection"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "restserver"
        },
        "spec": {
            "type": "server.rest.RestServerWorker",
            "ports": [5001],
            "adapters": [
                { "context": "a", "adapter": "attachadapter" },
                { "context": "b", "adapter": "bizadapter" },
                { "context": "e", "adapter": "entityadapter" },
                { "context": "c", "adapter": "collectionadapter" },
                { "context": "g", "adapter": "generatoradapter" },
                { "context": "o", "adapter": "queryoneadapter" },
                { "context": "r", "adapter": "replicationadapter" },
                { "context": "ri", "adapter": "imreplicationadapter" },
                { "context": "s", "adapter": "authadapter" },
                { "context": "otl", "adapter": "onetimeloginadapter" }
            ]
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "attachadapter"
        },
        "spec": {
            "type": "server.attach.AttachAdapter",
            "source": "db",
            "cache": "sessioncache",
            "sessionBackendSource": "db",
            "attachSource": "pgattachdb"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "bizadapter"
        },
        "spec": {
            "type": "server.adapter.BizAdapter",
            "source": "db",
            "cache": "sessioncache",
            "sessionBackendSource": "db"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "entityadapter"
        },
        "spec": {
            "type": "server.adapter.EntityAdapter",
            "source": "db",
            "cache": "sessioncache",
            "sessionBackendSource": "db"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "collectionadapter"
        },
        "spec": {
            "type": "server.adapter.CollectionAdapter",
            "source": "db",
            "cache": "sessioncache",
            "sessionBackendSource": "db"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "generatoradapter"
        },
        "spec": {
            "type": "server.adapter.GeneratorAdapter",
            "source": "db",
            "cache": "sessioncache",
            "sessionBackendSource": "db"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "queryoneadapter"
        },
        "spec": {
            "type": "server.adapter.QueryOneAdapter",
            "source": "db",
            "cache": "sessioncache",
            "sessionBackendSource": "db"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "replicationadapter"
        },
        "spec": {
            "type": "server.replication.ReplicationAdapter",
            "cache": "apisessioncache",
            "sessionBackendSource": "db",
            "source": "db",
            "replicationSource": "replicationdb"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "imreplicationadapter"
        },
        "spec": {
            "type": "server.replication.ReplicationAdapter",
            "cache": "apisessioncache",
            "sessionBackendSource": "db",
            "source": "db",
            "replicationSource": "imreplicationdb"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "authadapter"
        },
        "spec": {
            "type": "server.authentication.RZOAuthAdapter",
            "source": "db",
            "cache": "sessioncache",
            "sessionBackendSource": "db"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "onetimeloginadapter"
        },
        "spec": {
            "type": "server.authentication.RZOOneTimeAdapter",
            "source": "db",
            "cache": "sessioncache",
            "sessionBackendSource": "db",
            "persona": "onetimelogins"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "sessioncache"
        },
        "spec": {
            "type": "server.cache.CacheWorker",
            "ttl": 60000,
            "cacheCheckFrequency": 10000,
            "leaderElector": "leaderelector",
            "sessionBackendSource": "db",
            "backendCheckFrequency": 60000
        }
    },
    {
        "apiVersion": "v1",
        "kind": "Worker",
        "metadata": {
            "name": "apisessioncache"
        },
        "spec": {
            "type": "server.cache.APICacheWorker",
            "ttl": 30000,
            "cacheCheckFrequency": 10000
        }
    },
    {
        "apiVersion": "v1",
        "kind": "ReplicationFilter",
        "metadata": {
            "name": "activetrips"
        },
        "spec": {
            "type": "scheduler.trip.TripReplicationFilter"
        }
    },
    {
        "apiVersion": "v1",
        "kind": "LogConfiguration",
        "metadata": {
            "name": "logging"
        },
        "spec": {
            "defaultLevel": "Info",
            "loggers": [
                { "name": "server/mvcc", "level": "Info" },
                { "name": "server/restserver", "level": "Info" },
                { "name": "adapter", "level": "Info" },
                { "name": "adapter/replicationadapter", "level": "Info" },
                { "name": "adapter/imreplicationadapter", "level": "Info" },
                { "name": "adapter/entityadapter", "level": "Info" },
                { "name": "adapter/bizadapter", "level": "Debug" },
                { "name": "adapter/attachadapter", "level": "Info" },
                { "name": "balancelogger", "level": "Debug" },
                { "name": "entity/accsplit", "level": "Debug" },
                { "name": "hoover", "level": "Info" }
            ]
        }
    }
]

